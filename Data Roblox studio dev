-- Fungsi SFX disesuaikan dengan parameter durasi kustom
local function PlaySFX(soundId, duration)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = 0.5
    sound.Parent = SoundService
    sound:Play()
    
    task.delay(duration or 1.3, function()
        if sound then
            sound:Stop()
            sound:Destroy()
        end
    end)
end

local function AnimateGradient(gradient)
    task.spawn(function()
        while gradient and gradient.Parent do
            local tween = TweenService:Create(gradient, TweenInfo.new(3, Enum.EasingStyle.Linear), {Rotation = gradient.Rotation + 360})
            tween:Play()
            tween.Completed:Wait()
            gradient.Rotation = 0
        end
    end)
end

local function AttachParticles(parentFrame)
    task.spawn(function()
        while parentFrame and parentFrame.Parent do
            task.wait(math.random(3, 7) / 10)
            
            local Particle = Instance.new("Frame")
            local Size = math.random(2, 4)
            Particle.Size = UDim2.new(0, Size, 0, Size)
            Particle.Position = UDim2.new(math.random(5, 95) / 100, 0, 1, 5)
            Particle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Particle.BackgroundTransparency = math.random(2, 5) / 10
            Particle.BorderSizePixel = 0
            Particle.ZIndex = 1
            Particle.Parent = parentFrame

            local PartCorner = Instance.new("UICorner")
            PartCorner.CornerRadius = UDim.new(1, 0)
            PartCorner.Parent = Particle

            local TargetY = math.random(-20, 20) / 100
            local Duration = math.random(30, 60) / 10

            local TweenPos = TweenService:Create(Particle, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {
                Position = UDim2.new(Particle.Position.X.Scale + (math.random(-10, 10)/100), 0, TargetY, 0),
                BackgroundTransparency = 1
            })
            
            TweenPos:Play()
            TweenPos.Completed:Connect(function()
                Particle:Destroy()
            end)
        end
    end)
end

