local function ExecuteScript()
    if not TargetScriptURL then
        CheckBtn.Text = "Not Supported"
        CheckBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        ShowNotification("Execution Failed", "Map is currently not supported.", "Error")
        task.wait(2)
        CheckBtn.Text = "Verify Key"
        CheckBtn.BackgroundColor3 = Color3.fromRGB(35, 165, 90)
        return
    end
    
    local success, scriptContent = pcall(function()
        return game:HttpGet(TargetScriptURL)
    end)
    
    if success and scriptContent then
        ShowNotification("Success", "Key Validated! Loading Script...", "Success")
        task.wait(1)
        DestroyUI()
        loadstring(scriptContent)()
    else
        CheckBtn.Text = "Error Loading"
        CheckBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        ShowNotification("Error", "Failed to fetch script content.", "Error")
        task.wait(2)
        CheckBtn.Text = "Verify Key"
        CheckBtn.BackgroundColor3 = Color3.fromRGB(35, 165, 90)
    end
end

local function VerifyKeyAction()
    local InputtedKey = TextBox.Text
    if InputtedKey == CorrectKey then
        CheckBtn.Text = "Loading..."
        CheckBtn.BackgroundColor3 = Color3.fromRGB(230, 126, 34)
        ExecuteScript()
    else
        CheckBtn.Text = "Wrong Key!"
        CheckBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        -- Memutar SFX Denied dengan ID baru dan durasi 3 detik
        PlaySFX("rbxassetid://118626151223066", 3)
        ShowNotification("Access Denied", "Incorrect Key provided.", "Error")
        task.wait(2)
        CheckBtn.Text = "Verify Key"
        CheckBtn.BackgroundColor3 = Color3.fromRGB(35, 165, 90)
    end
end

